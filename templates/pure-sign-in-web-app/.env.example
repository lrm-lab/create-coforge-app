# Copy to .env. Never commit .env; the client secret stays on the server.
# COFORGE_CLIENT_SECRET and SESSION_SECRET are deliberately empty: the app will not start until you fill them.
# Every other value here is a placeholder too: replace it with your own.

# The CoForge issuer: <your CoForge origin>/oidc, no trailing slash.
COFORGE_ISSUER=https://coforge.example.com/oidc
# From Settings -> Applications in your Workspace when you register the app.
COFORGE_CLIENT_ID=__PACKAGE_NAME__
COFORGE_CLIENT_SECRET=
# Scopes to ask for. Add "email" only if the Workspace allowed it for this app.
COFORGE_SCOPES=openid profile identity

# Where this app is served. The redirect URI is APP_ORIGIN + /auth/callback.
APP_ORIGIN=http://localhost:3000
PORT=3000
# 32+ random characters: openssl rand -base64 48
SESSION_SECRET=
